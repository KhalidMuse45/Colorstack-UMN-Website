---
/**
 * Base layout. The token stylesheet is imported FIRST, before any component
 * style, so token declarations win the cascade order they were written for
 * (SETUP.md §5).
 */
import '../styles/styles.css';
import '../styles/base.css';
import NavBar from '../components/chrome/NavBar.astro';
import MobileSheet from '../components/chrome/MobileSheet.astro';
import Footer from '../components/chrome/Footer.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* The two faces above the fold on every page: the Archivo display cut
        (LCP element on the home masthead) and the Lora body cut. The Lora
        italic and Plex Mono cuts ride on font-display: swap. UX-SPEC §8. */}
    <link
      rel="preload"
      href="/fonts/archivo-normal-0186fb.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/lora-normal-ba4655.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <NavBar />
    <MobileSheet />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Skip-to-content (UX-SPEC §8): first tab stop, hidden until focused,
     surfaces above the sticky NavBar with the standard gold ring. */
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 70;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    background: var(--surface-page);
    color: var(--text-body);
    border-radius: var(--radius-control);
    font-family: var(--font-display);
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    transform: translateY(calc(-100% - var(--space-4)));
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
