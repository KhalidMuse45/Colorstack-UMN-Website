---
/**
 * `/` — the ColorStack UMN home page.
 *
 * Replaces the slice-1 scaffold specimen wholesale, as that file said it
 * would. Section order is `design/LANDING-PAGE.md` "Section order"; the
 * reference implementation is `design/reference/LandingPage.dc.html`.
 *
 * Every string, photo and link comes from `src/data/landing.ts`. Nothing on
 * this page is hardcoded copy, so the e-board can edit the site without
 * touching layout.
 *
 * Sections 1 and 13 (sticky nav and footer) come from Base.astro.
 * LANDING-PAGE.md:81: "you already have this. Keep yours."
 *
 * Voices is absent from the rendered output on purpose: the testimonials
 * array is empty because the reference's three quotes are placeholders that
 * LANDING-PAGE.md:133 says must not ship. The component returns null rather
 * than rendering a heading over an empty strip.
 */
import Base from '../layouts/Base.astro';

import Hero from '../components/landing/Hero.astro';
import HeroPhoto from '../components/landing/HeroPhoto.astro';
import StatBand from '../components/landing/StatBand.astro';
import Mission from '../components/landing/Mission.astro';
import Programs from '../components/landing/Programs.astro';
import Community from '../components/landing/Community.astro';
import InTheRoom from '../components/landing/InTheRoom.astro';
import Voices from '../components/landing/Voices.astro';
import GetInTouch from '../components/landing/GetInTouch.astro';
import Contact from '../components/landing/Contact.astro';
import Closer from '../components/landing/Closer.astro';
import Fab from '../components/landing/Fab.astro';
---

<Base
  title="ColorStack UMN — Black and Latinx computer science at the U"
  description="A home for Black and Latinx computer science students at the University of Minnesota. Workshops, leadership, professional development, and a community that shows up."
>
  <Hero />
  <HeroPhoto />
  <StatBand />
  <Mission />
  <Programs />
  <Community />
  <InTheRoom />
  <Voices />
  <GetInTouch />
  <Contact />
  <Closer />
  <Fab />
</Base>
