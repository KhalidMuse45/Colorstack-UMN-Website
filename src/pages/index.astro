---
/**
 * SLICE 1 SCAFFOLD GATE — not the real home page.
 *
 * This is a token-and-type specimen whose only job is to make the SETUP.md
 * §10 checklist verifiable by eye: cream ground, all three layout faces
 * rendering, hairline rules, a mono meta row, and a visible gold focus ring.
 *
 * The real `/` is built in slice 5 against UX-SPEC.md §5.1. This file is
 * replaced wholesale then — do not grow features on it.
 */
import Base from '../layouts/Base.astro';

const faces = [
  {
    token: '--font-display',
    name: 'Archivo',
    role: 'Display, headlines, masthead',
    rule: 'Weights 500–900. Tracking −0.01em. Never all caps above 24px.',
  },
  {
    token: '--font-body',
    name: 'Lora',
    role: 'Body, editorial',
    rule: 'Ledes are italic. Leading 1.55. Max measure 68ch.',
  },
  {
    token: '--font-mono',
    name: 'IBM Plex Mono',
    role: 'Meta, labels, captions, timestamps',
    rule: '11px, uppercase, tracking +0.08em.',
  },
];
---

<Base
  title="ColorStack UMN — scaffold"
  description="Slice 1 scaffold gate for the ColorStack UMN chapter site rebuild."
>
  <main class="wrap">
    <div class="meta-row">
      <span>ColorStack UMN</span>
      <span>Slice 01 — Scaffold</span>
      <span>Tokens wired</span>
    </div>

    <h1>Chapter Notes, expanded to a site.</h1>
    <p class="lede">
      The scaffold is standing. Ground is <code>--cream</code>, the three
      layout faces are self-hosted, and every value below resolves through a
      token — nothing on this page is a literal.
    </p>

    <section aria-labelledby="faces">
      <div class="meta-row">
        <span id="faces">№ 01 — Type</span>
        <span>Three faces</span>
      </div>
      <dl class="faces">
        {
          faces.map((f) => (
            <div class="face">
              <dt style={`font-family: var(${f.token})`}>{f.name}</dt>
              <dd>
                <span class="role">{f.role}</span>
                <span class="rule">{f.rule}</span>
                <p class="specimen" style={`font-family: var(${f.token})`}>
                  Black &amp; Latinx computer science at the University of
                  Minnesota — 0123456789
                </p>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="focus">
      <div class="meta-row">
        <span id="focus">№ 02 — Focus</span>
        <span>Tab to check the ring</span>
      </div>
      <p class="lede">
        <a href="https://colorstackumn.org/">This link</a> and
        <button type="button">this button</button> must both show a 2px gold
        ring at 2px offset when reached by keyboard.
      </p>
    </section>
  </main>
</Base>

<style>
  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-5) var(--space-5) var(--space-8);
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--hairline);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  h1 {
    font-size: var(--text-h1);
    font-weight: 900;
    color: var(--text-heading);
    margin: var(--space-6) 0 var(--space-4);
    max-width: 20ch;
  }

  .lede {
    font-style: italic;
    font-size: var(--text-h3);
    max-width: 68ch;
    margin-bottom: var(--space-7);
    color: var(--text-body);
  }

  code {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--accent-primary);
  }

  .faces {
    margin: 0;
    padding: 0;
  }

  .face {
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--border-default);
  }

  dt {
    font-size: var(--text-h2);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
  }

  dd {
    margin: var(--space-2) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .role,
  .rule {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .specimen {
    font-size: var(--text-h3);
    max-width: 68ch;
    margin-top: var(--space-2);
  }

  button {
    font: inherit;
    font-family: var(--font-display);
    font-weight: 600;
    background: var(--accent-highlight);
    color: var(--text-on-gold);
    border: 0;
    border-radius: var(--radius-pill);
    padding: var(--space-2) var(--space-5);
    min-height: 44px;
    cursor: pointer;
  }

  a {
    color: var(--accent-primary);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  @media (min-width: 900px) {
    .wrap {
      padding-block: var(--space-8);
    }

    h1 {
      font-size: var(--text-hero);
    }
  }
</style>
