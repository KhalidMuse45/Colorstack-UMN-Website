---
/**
 * Partner band. Sits between the contact rows and the split closer, so the
 * page ends on credibility rather than simply stopping.
 *
 * RENDERS NOTHING TODAY, ON PURPOSE.
 * `partners` in `src/data/landing.ts` is an empty array because no sponsor or
 * partner exists anywhere in this repository. This component returns null
 * rather than shipping a heading over an empty strip, which is the same
 * contract `Voices.astro` uses for testimonials and what UX-SPEC section 5.1
 * requires: never render an empty band.
 *
 * Add entries to `partners` and drop the logo files into
 * `public/images/partners/` and the section appears. Nothing else changes.
 *
 * Logos are rendered at a fixed height on a neutral ground rather than in
 * boxes, because a logo wall of mismatched lockups in cards is the exact
 * "SaaS template" look UX-SPEC section 9 rules out.
 */
import ScrollScene from '../motion/ScrollScene.astro';
import SectionLabel from './SectionLabel.astro';
import { partners, partnerBand } from '../../data/landing';

const hasPartners = partners.length > 0;
---

{
  hasPartners && (
    <section class="partners" aria-labelledby="partners-title">
      <div class="partners-inner">
        <ScrollScene effect="rise" range="entry 0% cover 35%">
          <SectionLabel>{partnerBand.label}</SectionLabel>
          <h2 class="partners-title" id="partners-title">
            {partnerBand.headline}
          </h2>
        </ScrollScene>

        <ScrollScene effect="rise" range="entry 10% cover 45%" class="partners-row">
          {partners.map((p) =>
            p.href ? (
              <a class="partner" href={p.href} target="_blank" rel="noopener noreferrer">
                <img src={p.logo} alt={p.name} height="40" loading="lazy" decoding="async" />
              </a>
            ) : (
              <span class="partner">
                <img src={p.logo} alt={p.name} height="40" loading="lazy" decoding="async" />
              </span>
            )
          )}
        </ScrollScene>

        <ScrollScene effect="rise" range="entry 18% cover 52%">
          <a class="partners-cta" href={partnerBand.ctaHref}>
            {partnerBand.cta}
            <span aria-hidden="true" class="partners-arrow">
              ↗
            </span>
          </a>
        </ScrollScene>
      </div>
    </section>
  )
}

<style>
  .partners {
    background: var(--paper);
    border-top: 1px solid var(--line);
  }

  .partners-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(56px, 8vw, 96px) var(--space-5);
  }

  .partners-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: var(--maroon);
    margin: 14px 0 0;
    text-wrap: balance;
  }

  .partners-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(28px, 5vw, 56px);
    margin: clamp(32px, 4vw, 48px) 0;
  }

  /* Marks sit on the ground, not in boxes. A grid of bordered cards holding
     mismatched lockups is the SaaS look UX-SPEC section 9 rules out. */
  .partner {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-control);
  }

  .partner img {
    display: block;
    height: 40px;
    width: auto;
  }

  .partner:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 4px;
  }

  .partners-cta {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17px;
    color: var(--maroon);
    text-decoration: none;
    border-bottom: 1px solid var(--maroon);
    padding-bottom: 2px;
  }

  .partners-cta:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .partners-arrow {
    font-size: 0.9em;
  }
</style>
