---
/**
 * Get in touch. Section 10 of the LANDING-PAGE section order: maroon band,
 * TextRoll headline, mailing-list form.
 * `design/reference/LandingPage.dc.html:196-216`.
 *
 * This is the conversion point of the whole page, so the form is a real form
 * that works with JavaScript disabled: a plain GET to the Logicform endpoint,
 * which is the same endpoint every other CTA on the page uses. The constant
 * lives in src/data/landing.ts so the four call sites cannot drift.
 *
 * The label wraps the input rather than using `for`, so the hit area includes
 * the text and no id has to stay unique across the page.
 *
 * PROGRESSIVE ENTRANCE
 * The band arrives in stages rather than as one block, so the reader feels
 * they are approaching somewhere rather than watching a slide change. Order:
 *
 *   0.00s  the stem, a hairline that reaches up out of the maroon into the
 *          previous section's whitespace
 *   0.00s  the ground: a fine diagonal weave and two tonal glows
 *   0.12s  the headline rolls in, character by character
 *   0.24s  the supporting paragraph
 *   0.36s  the form
 *
 * Every stage is `Reveal`, whose contract is that the SERVER renders the
 * final, visible state and the script only ever ADDS the hidden one, and only
 * when JS runs and the visitor has not asked for reduced motion. So the form
 * cannot be stranded: no JS, reduced motion, a missing IntersectionObserver, a
 * throw, or an observer that never fires all leave it exactly as the server
 * sent it, which is visible, labelled and submittable. Nothing in this file
 * hides the form; only Reveal's script can, and only after proving it can
 * unhide it again. That also means the staging is decoration on top of a
 * working form, never a precondition for one.
 *
 * The section is deliberately NOT full height. The padding below is the same
 * editorial rhythm as every other band on the page.
 *
 * The two glows are `--maroon-light` rather than gold on purpose. A gold wash
 * behind gold-soft label text is the one thing here that could eat the form's
 * contrast; a tonal shift inside the maroon family moves the background
 * luminance by almost nothing (gold-soft on the lit ground still measures
 * about 8:1) while still reading as light moving behind the form.
 */
import TextRoll from '../motion/TextRoll.astro';
import Reveal from '../motion/Reveal.astro';
import { getInTouch } from '../../data/landing';
---

<section id="get-in-touch" class="git">
  <Reveal class="git-stem" aria-hidden="true" />

  <Reveal class="git-ground" aria-hidden="true">
    <span class="git-weave"></span>
    <span class="git-glow git-glow-a"></span>
    <span class="git-glow git-glow-b"></span>
  </Reveal>

  <div class="git-inner">
    <div class="git-copy">
      <h2 class="git-title">
        <TextRoll stagger={0.024} duration={700} delay={0.12}>{getInTouch.headline}</TextRoll>
      </h2>
      <Reveal index={2}>
        <p class="git-body">{getInTouch.body}</p>
      </Reveal>
    </div>

    <Reveal as="form" class="git-form" action={getInTouch.formAction} method="get" target="_blank" index={3}>
      <label class="git-label">
        {getInTouch.fieldLabel}
        <input type="email" name="email" placeholder={getInTouch.placeholder} required autocomplete="email" />
      </label>
      <div class="git-actions">
        <button type="submit">{getInTouch.submit}</button>
        <a href={getInTouch.altHref}>{getInTouch.altLabel}</a>
      </div>
    </Reveal>
  </div>
</section>

<style>
  .git {
    position: relative;
    background: var(--maroon);
    color: var(--cream);
    /* The overlap the brief asks for. The maroon ground starts inside the
       previous section's trailing whitespace instead of butting up against
       it, so the page reads as continuous rather than as stacked blocks.
       Bounded well under that section's bottom padding at every width, so no
       content of theirs can ever collide with this band. Static geometry, so
       it costs no layout shift. */
    margin-top: calc(-1 * clamp(32px, 5vw, 72px));
  }

  /* A hairline that reaches up out of the band into the section above: the
     literal overlap, and the first thing to arrive. Decorative, out of flow,
     kept shorter than the gap the negative margin leaves behind so it cannot
     land on the photo grid. Reveal's 16px rise makes it grow out of the
     maroon, since its lower half is invisible against the band. */
  .git-stem {
    position: absolute;
    bottom: 100%;
    left: max(var(--space-5), calc(50% - 600px + var(--space-5)));
    width: 2px;
    height: clamp(20px, 2.2vw, 30px);
    background: linear-gradient(to bottom, transparent, var(--maroon));
    pointer-events: none;
  }

  /* Texture and light. Sits behind everything, contains its own overflow so
     the glows can hang off the edges without widening the page. */
  .git-ground {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .git-weave {
    position: absolute;
    inset: 0;
    opacity: 0.05;
    background-image: repeating-linear-gradient(
      -45deg,
      var(--cream) 0,
      var(--cream) 1px,
      transparent 1px,
      transparent 10px
    );
  }

  .git-glow {
    position: absolute;
    width: min(78vw, 660px);
    height: min(78vw, 660px);
    border-radius: 50%;
    background: radial-gradient(circle closest-side, var(--maroon-light), transparent);
    opacity: 0.55;
  }

  .git-glow-a {
    top: -22%;
    left: -12%;
  }

  .git-glow-b {
    bottom: -28%;
    right: -10%;
  }

  /* The movement that continues behind the form. Transform only, so it stays
     on the compositor, and slow enough (38s and 52s for a few per cent of
     travel) that it never competes with the form for attention. */
  @media (prefers-reduced-motion: no-preference) {
    .git-glow-a {
      animation: git-drift-a 38s ease-in-out infinite alternate;
    }

    .git-glow-b {
      animation: git-drift-b 52s ease-in-out infinite alternate;
    }
  }

  @keyframes git-drift-a {
    from {
      transform: translate3d(-3%, -2%, 0);
    }

    to {
      transform: translate3d(4%, 3%, 0);
    }
  }

  @keyframes git-drift-b {
    from {
      transform: translate3d(3%, 2%, 0);
    }

    to {
      transform: translate3d(-4%, -3%, 0);
    }
  }

  .git-inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(72px, 10vw, 132px) var(--space-5);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .git-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .git-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(36px, 5.4vw, 74px);
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--gold);
  }

  .git-body {
    font-family: var(--font-body);
    font-size: 18.5px;
    line-height: 1.62;
    max-width: 40ch;
    text-wrap: pretty;
  }

  .git-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .git-label {
    display: flex;
    flex-direction: column;
    gap: 9px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-small);
    color: var(--gold-soft);
  }

  .git-label input {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--ink);
    background: var(--cream);
    border: 1px solid var(--hairline-inverse);
    border-radius: var(--radius-control);
    padding: var(--space-4) var(--space-5);
    min-height: 44px;
  }

  .git-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    align-items: center;
  }

  .git-actions button {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16.5px;
    background: var(--gold);
    color: var(--text-on-gold);
    border: none;
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-control);
    cursor: pointer;
    min-height: 44px;
  }

  .git-actions a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    color: var(--gold-soft);
    text-decoration: none;
  }

  .git-actions a:hover {
    color: var(--gold);
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: no-preference) {
    .git-actions button {
      transition: background 240ms ease;
    }

    .git-actions a {
      transition: color 220ms ease;
    }
  }

  .git-actions button:hover {
    background: var(--gold-dark);
  }
</style>
