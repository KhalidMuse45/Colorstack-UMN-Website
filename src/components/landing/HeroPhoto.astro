---
/**
 * Full-bleed group photo. Section 3 of the LANDING-PAGE section order.
 * `design/reference/LandingPage.dc.html:66-68`.
 *
 * Unfolds via clip-path rather than fading, which is the "unfolding paper"
 * treatment UX-SPEC 6 specifies for images.
 *
 * width and height are emitted so the browser reserves the box before the
 * file lands. The photo is above the fold on most viewports, so it is
 * eager and high priority: lazy-loading the LCP image would cost more than
 * it saves.
 */
import Reveal from '../motion/Reveal.astro';
import { hero } from '../../data/landing';

const photo = hero.photo;
---

<Reveal as="figure" wipe class="hero-photo">
  <img
    src={photo.src}
    srcset="/images/summit-group-800.webp 800w, /images/summit-group-1600.webp 1600w, /images/summit-group.webp 2400w"
    sizes="100vw"
    alt={photo.alt}
    width={photo.width}
    height={photo.height}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    style={photo.objectPosition ? `object-position:${photo.objectPosition}` : undefined}
  />
</Reveal>

<style>
  .hero-photo {
    margin: 0;
    width: 100%;
    background: var(--photo-ground);
    overflow: hidden;
  }

  .hero-photo img {
    display: block;
    width: 100%;
    height: clamp(300px, 48vw, 600px);
    object-fit: cover;
    filter: var(--photo-tint);
  }

  /* The conference photo is the only image here, so the movement has to come
     from the frame itself rather than from cutting to another shot.
     Two beats:
       arrive   the photo settles back from slightly over-scaled as the
                clip-path wipe opens it, so it lands rather than appears.
       breathe  a very slow push in and out afterwards. This is the cinematic
                treatment: at 26s a reader never catches it moving, they just
                register that the room is not a still.

     Transform only, so it is compositor work and cannot cost layout or paint.
     The figure already clips, so the scale never spills into the band edges.
     Deliberately restrained: anything faster reads as a slideshow effect
     rather than a photograph that happens to be alive. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-photo img {
      animation:
        hero-arrive 1400ms cubic-bezier(0.22, 1, 0.36, 1) both,
        hero-breathe 26s ease-in-out 1400ms infinite alternate;
    }
  }

  @keyframes hero-arrive {
    from {
      transform: scale(1.055);
    }
    to {
      transform: scale(1);
    }
  }

  @keyframes hero-breathe {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.045);
    }
  }
</style>
