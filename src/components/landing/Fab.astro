---
/**
 * Fixed gooey CTA, bottom right. `design/LANDING-PAGE.md:41` and
 * `design/reference/LandingPage.dc.html:273-279`.
 *
 * Offset is 44px, NOT the reference's clamp(18px,3vw,36px). At 375px that
 * clamp resolves to 18px and the open fan extends about 38px past the
 * trigger's right edge, pushing the rightmost item off screen. Measured
 * during the motion port; recorded in HANDOFF-LOG.md.
 */
import LiquidMenu from '../motion/LiquidMenu.astro';
import { MAILING_LIST, contact } from '../../data/landing';
---

<div class="fab">
  <LiquidMenu label="Get in touch" radius={76} size={62} blur={7} contrast={20}>
    {/*
      The chapter mark replaces the `+`. The mark carries its own maroon
      ground, so it fills the circle rather than sitting on one, and the
      button clips it round.

      Served from a 192px variant, not the 1544px master the nav uses. This
      renders at 62px, so the master would be roughly a 25x oversupply decoded
      on every page load: 1.8KB as WebP against 34.6KB for the same crop as a
      PNG.

      alt is empty on purpose. The button already carries aria-label "Get in
      touch", and a second name here would announce the control twice.
    */}
    <img
      slot="trigger"
      src="/images/colorstack-umn-mark-192.webp"
      alt=""
      width="62"
      height="62"
      decoding="async"
    />

    <a href={`mailto:${contact.email}`} aria-label={`Email ColorStack UMN at ${contact.email}`}>✉</a>
    <a
      href="https://www.instagram.com/colorstackumn/"
      target="_blank"
      rel="noopener"
      aria-label="ColorStack UMN on Instagram">IG</a
    >
    <a href={MAILING_LIST} target="_blank" rel="noopener" aria-label="Join the ColorStack UMN mailing list">Join</a>
  </LiquidMenu>
</div>

<style>
  .fab {
    position: fixed;
    right: 44px;
    bottom: 44px;
    z-index: 70;
  }

  /* Do NOT shrink `right` at small widths. 375px is exactly where the fan
     overflows, so tightening the offset there is backwards. Only `bottom`
     relaxes, which costs nothing horizontally. */
  @media (max-width: 640px) {
    .fab {
      bottom: var(--space-6);
    }
  }
</style>
