---
/**
 * Maroon stat band. Section 4 of the LANDING-PAGE section order.
 * `design/reference/LandingPage.dc.html:70-86`.
 *
 * The numbers are chapter-confirmed. See the note at the point of definition
 * in `src/data/landing.ts`: the retired site advertised 25+ offers where this
 * says 10+, which is worth a second look before launch. Do not edit them here.
 *
 * If `stats` is ever emptied, the band collapses to the qualitative line
 * rather than rendering an empty maroon slab. UX-SPEC 5.1.3 forbids empty
 * bands and the same instinct applies here.
 */
import Reveal from '../motion/Reveal.astro';
import NumberRoll from '../motion/NumberRoll.astro';
import { stats, statsAside } from '../../data/landing';
---

<section class="stat-band" data-stat-band>
  <div class="stat-inner">
    <div class="stat-grid">
      {
        stats.map((stat, i) => (
          <Reveal class="stat" index={i}>
            <NumberRoll class="stat-value" duration={0.55} stagger={0.05} spins={3} blur={6} cue>
              {stat.value}
            </NumberRoll>
            <span class="stat-label">{stat.label}</span>
          </Reveal>
        ))
      }
      <Reveal class="stat-aside" index={stats.length}>
        <p>{statsAside}</p>
      </Reveal>
    </div>
  </div>
</section>

<style>
  .stat-band {
    background: var(--maroon);
    color: var(--text-on-maroon);
  }

  .stat-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(52px, 7vw, 84px) var(--space-5);
  }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(28px, 4vw, 48px);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .stat-value {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(58px, 8vw, 104px);
    line-height: 0.88;
    letter-spacing: -0.035em;
    color: var(--gold);
    /* Keeps 100+ and 10+ from shifting width as the page settles. */
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    color: var(--gold-soft);
  }

  .stat-aside {
    display: flex;
    align-items: flex-end;
  }

  .stat-aside p {
    font-family: var(--font-body);
    font-size: 17.5px;
    line-height: 1.6;
    color: var(--cream);
    max-width: 38ch;
    text-wrap: pretty;
  }

  /* The reel is one digit tall and clips, so the oversized line-height the
     display face carries would crop the glyphs. Only the slot needs the tight
     box; the value keeps its own leading everywhere else. */
  .stat-value :global(.nr-slot),
  .stat-value :global(.nr-digit),
  .stat-value :global(.nr-fixed) {
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  /**
   * Sequencer. The reels here are `cue`d, so they sit on their final digits
   * until told to spin, and this decides when the band has arrived.
   *
   * Two cases, because the reveal itself has two:
   *   below the fold  the stats were armed, so give the rise a short head
   *                   start and let the two motions overlap.
   *   above the fold  Reveal deliberately never arms what is already on screen
   *                   (that fix is what took LCP from 4378ms to 1744ms), so
   *                   there is no reveal to wait for and the reels lead.
   */
  (() => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const band = document.querySelector<HTMLElement>('[data-stat-band]');
    if (!band) return;

    // Deliberately NOT the full 800ms reveal. The reels start while the band
    // is still rising, so the two motions overlap and the jackpot reads as
    // part of the arrival rather than a second event queued behind it. Waiting
    // for the reveal to finish first tested at nearly a second of dead air,
    // long enough to read the number before anything happened to it.
    const OVERLAP_MS = 260;

    const fire = () => {
      const reels = Array.from(
        band.querySelectorAll<HTMLElement>('[data-number-roll]')
      );
      if (!reels.length) return;

      const armed = band.querySelector('[data-rv]') !== null;
      const settle = armed ? OVERLAP_MS : 120;

      window.setTimeout(() => {
        // Second stat starts a beat after the first, so the band lands like
        // two reels stopping in sequence rather than one block flipping.
        reels.forEach((el, i) => {
          window.setTimeout(() => {
            const go = (el as any).nrSpin;
            if (typeof go === 'function') go();
          }, i * 90);
        });
      }, settle);
    };

    if (typeof IntersectionObserver === 'undefined') {
      fire();
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          fire();
        });
      },
      { threshold: 0.35 }
    );
    io.observe(band);
  })();
</script>
