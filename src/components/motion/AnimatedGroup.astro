---
/**
 * AnimatedGroup. Staggered entrance for a set of children.
 * Port of design/components/motion/AnimatedGroup.jsx.txt, props per types.d.ts.
 *
 * PROGRESSIVE ENHANCEMENT CONTRACT
 * The server renders every child in its final, visible state. There is no
 * pre-animation CSS on the page until the client script adds
 * [data-motion="armed"], and it only does that when JS runs AND the visitor
 * has not asked for reduced motion. An IntersectionObserver then flips the
 * attribute to "in"; a 2.5s failsafe, an observer-less browser, and a thrown
 * error all land on the revealed state. Nothing can strand a child at
 * opacity: 0, which for the blur-slide preset would mean a whole photo grid
 * disappearing.
 *
 * Astro cannot map over slot children at build time, so the per-item
 * transition delay is written onto each child element by the script, walking
 * root.children (elements only). root.childNodes would pick up the newlines
 * between sibling elements as text nodes, which is the documented
 * whitespace-children trap (LANDING-PAGE.md:68) that produced empty grid
 * cells in the original build.
 */
interface Props {
  /** Hidden-state treatment for each child */
  preset?: 'blur-slide' | 'rise' | 'scale' | 'fade';
  /** Seconds between children */
  stagger?: number | string;
  /** Seconds before the first child animates */
  delay?: number | string;
  /** When set, the group lays itself out as an auto-fit grid with this min column width (px) */
  minColumnWidth?: number | string;
  /** Grid gap in px, used with minColumnWidth */
  gap?: number | string;
  /** Animate only the first time it enters view */
  once?: boolean | string;
  /** Element tag to render */
  as?: string;
  class?: string;
  style?: string;
}

const {
  preset = 'blur-slide',
  stagger = 0.05,
  delay = 0,
  minColumnWidth,
  gap = 20,
  once = true,
  as = 'div',
  class: className,
  style,
  ...rest
}: Props = Astro.props;

/* Numeric props can arrive as strings from a template (LANDING-PAGE.md:77),
   where an unconverted value silently drops out of the CSS. Coerce, and fall
   back to the documented default when the result is not a finite number. */
const num = (v: unknown, d: number): number => {
  if (v === undefined || v === null || v === '') return d;
  const parsed = Number(v);
  return Number.isFinite(parsed) ? parsed : d;
};

const staggerN = num(stagger, 0.05);
const delayN = num(delay, 0);
const gapN = num(gap, 20);
const isGrid = minColumnWidth !== undefined && minColumnWidth !== null && minColumnWidth !== '';
const minColN = num(minColumnWidth, 240);
const onceN = once !== false && once !== 'false';

/* Layout config travels as custom properties so the stylesheet stays static
   and a caller-supplied `style` can still merge cleanly onto one attribute. */
const ownStyle = isGrid ? `--ag-min:${minColN}px;--ag-gap:${gapN}px` : '';
const mergedStyle = [ownStyle, style].filter(Boolean).join(';') || undefined;

const Tag = as as any;
---

<Tag
  data-animated-group
  data-preset={preset}
  data-stagger={String(staggerN)}
  data-delay={String(delayN)}
  data-once={String(onceN)}
  data-grid={isGrid ? '' : undefined}
  class={className}
  style={mergedStyle}
  {...rest}
>
  <slot />
</Tag>

{/* Slotted children carry the parent component's scope hash, not this one, so
    scoped styles would never reach them. Selectors are namespaced under
    [data-animated-group] to keep the global surface tight. */}
<style is:global>
  [data-animated-group] {
    perspective: 1000px;
  }

  [data-animated-group][data-grid] {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--ag-min), 1fr));
    gap: var(--ag-gap);
  }

  [data-animated-group] > * {
    transform-style: preserve-3d;
  }

  /* Everything below applies only once the script has armed the group. With
     no JS, reduced motion, or a script error, none of these selectors match
     and the children keep their natural, visible state. */
  [data-animated-group][data-motion='armed'] > * {
    opacity: 0;
    will-change: opacity, transform, filter;
  }

  [data-animated-group][data-preset='blur-slide'][data-motion='armed'] > * {
    filter: blur(12px);
    transform: translateY(-46px) rotateX(52deg);
  }

  [data-animated-group][data-preset='rise'][data-motion='armed'] > * {
    transform: translateY(28px);
  }

  [data-animated-group][data-preset='scale'][data-motion='armed'] > * {
    transform: scale(0.86);
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-animated-group][data-motion] > * {
      transition:
        opacity 900ms cubic-bezier(0.22, 1, 0.36, 1),
        transform 900ms cubic-bezier(0.34, 1.3, 0.5, 1),
        filter 700ms cubic-bezier(0.22, 1, 0.36, 1);
    }
  }
</style>

<script>
  // Module scope: this runs once per page, so every instance is selected by
  // its data attribute and wired independently. No shared state.
  const groups = document.querySelectorAll<HTMLElement>('[data-animated-group]');

  groups.forEach((root) => {
    // Reduced motion never arms the group. The content is already visible in
    // the server HTML, so returning here is the correct, complete outcome.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Elements only. childNodes would include the newlines between siblings.
    const kids = Array.from(root.children) as HTMLElement[];
    if (kids.length === 0) return;

    const reveal = () => {
      root.dataset.motion = 'in';
    };

    try {
      const stagger = Number(root.dataset.stagger) || 0;
      const delay = Number(root.dataset.delay) || 0;
      kids.forEach((kid, i) => {
        kid.style.transitionDelay = `${delay + i * stagger}s`;
      });

      root.dataset.motion = 'armed';

      // From here on the children are hidden, so every exit path must reveal.
      const failsafe = window.setTimeout(reveal, 2500);

      if (typeof IntersectionObserver === 'undefined') {
        window.clearTimeout(failsafe);
        reveal();
        return;
      }

      const once = root.dataset.once !== 'false';
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              window.clearTimeout(failsafe);
              reveal();
              if (once) io.disconnect();
            } else if (!once) {
              root.dataset.motion = 'armed';
            }
          });
        },
        { threshold: 0.06 }
      );
      io.observe(root);
    } catch {
      // Any failure after arming would leave the grid blank. Reveal instead.
      reveal();
    }
  });
</script>
