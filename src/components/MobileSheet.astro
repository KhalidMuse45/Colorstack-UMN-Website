---
/**
 * Mobile navigation sheet (UX-SPEC §2 / §8).
 *
 * Full-bleed maroon overlay, slides down from the NavBar. Links are Archivo
 * (32px — the type scale has no 32 token, so --space-6, the only 32px token,
 * carries that size), `Join` is a gold pill pinned to the bottom of the sheet.
 *
 * Owns sheet state: opens from the NavBar hamburger ([data-nav-toggle]),
 * traps Tab inside while open, closes on Esc, and returns focus to the
 * hamburger. Runs only when JS is present; without JS the sheet stays in
 * `hidden` so no-JS visitors never see a dead overlay.
 */
import { primaryNav, joinCta } from '../data/nav';
---

<div
  class="sheet"
  id="mobile-sheet"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
  data-nav-sheet
  hidden
>
  <div class="sheet-head">
    <span class="sheet-kicker" id="sheet-kicker">Menu</span>
    <button
      class="sheet-close"
      type="button"
      data-sheet-close
      aria-label="Close menu"
    >
      Close <span class="sheet-close-glyph" aria-hidden="true">&#10006;</span>
    </button>
  </div>

  <nav class="sheet-nav" aria-label="Mobile">
    <ul class="sheet-list">
      {
        primaryNav.map((l) => (
          <li class="sheet-item">
            <a class="sheet-link" href={l.href}>{l.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>

  <a class="sheet-cta" href={joinCta.href}>{joinCta.label}</a>
</div>

<style>
  .sheet {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    background: var(--maroon);
    color: var(--text-on-maroon);
    overflow-y: auto;
    /* Closed state: off-canvas above the viewport. Static, outside the
       motion gate. */
    transform: translateY(-100%);
    visibility: hidden;
    overscroll-behavior: contain;
  }

  .sheet[hidden] {
    display: none;
  }

  .sheet.is-open {
    transform: translateY(0);
    visibility: visible;
  }

  .sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--hairline-inverse);
  }

  .sheet-kicker {
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-on-maroon);
  }

  .sheet-close {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 44px;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    border: 0;
    background: none;
    color: var(--text-on-maroon);
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    cursor: pointer;
  }

  .sheet-close:hover,
  .sheet-close:focus-visible {
    background: var(--maroon-deep);
  }

  .sheet-close-glyph {
    pointer-events: none;
  }

  .sheet-nav {
    margin-top: var(--space-5);
  }

  .sheet-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sheet-item {
    border-bottom: 1px solid var(--hairline-inverse);
  }

  /* Archivo 32px links (§2). 32px has no type token in the slice-1 scale, so
     it resolves through --space-6 (32px) — the only declared 32px value. */
  .sheet-link {
    position: relative;
    z-index: 0;
    display: block;
    min-height: 44px;
    padding-block: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--space-6);
    font-weight: 700;
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-display);
    color: var(--text-on-maroon);
    text-decoration: none;
  }

  /* Same link treatment as desktop (§6): --gold-soft highlighter swipe
     behind the text plus an underline, drawn with pseudo-elements. */
  .sheet-link::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: var(--space-3) 0 var(--space-3);
    background: var(--gold-soft);
    transform: scaleX(0);
    transform-origin: left;
  }

  .sheet-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--space-2);
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
  }

  .sheet-link:hover::before,
  .sheet-link:focus-visible::before,
  .sheet-link:hover::after,
  .sheet-link:focus-visible::after {
    transform: scaleX(1);
  }

  /* Join — gold pill pinned to the bottom of the sheet (§2). */
  .sheet-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin-top: auto;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-control);
    background: var(--accent-highlight);
    color: var(--text-on-gold);
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    text-decoration: none;
  }

  .sheet-cta:hover,
  .sheet-cta:focus-visible,
  .sheet-cta:active {
    background: var(--gold-dark);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Slide-down (§2) and the swipe underline spend their movement here. */
    .sheet {
      transition:
        transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0.35s;
    }

    .sheet-link::before,
    .sheet-link::after {
      transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }
  }

  @media (min-width: 900px) {
    .sheet {
      display: none;
    }
  }
</style>

<script>
  const sheet = document.querySelector<HTMLElement>('[data-nav-sheet]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const closeButton =
    (sheet && sheet.querySelector<HTMLButtonElement>('[data-sheet-close]')) ||
    undefined;

  // Without a sheet or trigger nothing can be wired (e.g. unit tests mounting
  // the sheet alone). Guard the whole wiring so both types narrow and the
  // module always has a legal top level.
  if (sheet && toggle) {
    const sheetEl = sheet;
    const toggleEl = toggle;

    const noPreference = window.matchMedia(
      '(prefers-reduced-motion: no-preference)'
    );

    const focusables = () =>
      Array.from(
        sheetEl.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled])'
        )
      ).filter(
        (el) => el.offsetParent !== null || el === document.activeElement
      );

    // Hide the sheet once the slide-out transform finishes; with reduced
    // motion there is no transition event, so hide immediately there.
    // The handler lives at block scope so open() can disarm a stale listener
    // before a new slide starts.
    function hideOnEnd(e: Event) {
      if ((e as TransitionEvent).propertyName !== 'transform') return;
      sheetEl.removeEventListener('transitionend', hideOnEnd);
      // If the sheet was reopened mid-close, the open transition's end must
      // not hide an open dialog.
      if (sheetEl.classList.contains('is-open')) return;
      sheetEl.hidden = true;
    }

    function hideWhenDone() {
      if (noPreference.matches) {
        sheetEl.addEventListener('transitionend', hideOnEnd);
      } else {
        sheetEl.hidden = true;
      }
    }

    function open() {
      // Disarm any stale close-transition listener before the slide-in.
      sheetEl.removeEventListener('transitionend', hideOnEnd);
      sheetEl.hidden = false;
      // Force a frame so the browser sees the closed state first, then slide.
      requestAnimationFrame(() => {
        sheetEl.classList.add('is-open');
        toggleEl.setAttribute('aria-expanded', 'true');
        (closeButton || focusables()[0] || sheetEl).focus();
      });
      document.addEventListener('keydown', onKeydown);
    }

    function close() {
      if (!sheetEl.classList.contains('is-open')) return;
      sheetEl.classList.remove('is-open');
      toggleEl.setAttribute('aria-expanded', 'false');
      toggleEl.focus();
      document.removeEventListener('keydown', onKeydown);
      hideWhenDone();
    }

    function onKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }
      if (e.key !== 'Tab') return;
      // Keep Tab inside the sheet (§8). Wrap from the last/first target.
      const items = focusables();
      if (items.length === 0) {
        e.preventDefault();
        return;
      }
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;
      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    }

    document.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof Element)) return;
      const trigger = e.target.closest('[data-nav-toggle]');
      if (!trigger) return;
      if (sheetEl.classList.contains('is-open')) {
        close();
      } else {
        open();
      }
    });
  }
</script>